# Production environment for broker/compose.production.yml.
#
# Copy to .env.production, set DOMAIN and ACME_EMAIL, then run
# scripts/setup-production.sh to append freshly generated broker passwords.
# .env.production is git-ignored; treat it as the deployment's secret store.

# === Required ===

# Public hostname of the broker. An A record for this name must already point
# at the instance's public IP before the first deploy, because Caddy proves
# control of it over ACME. Browsers use wss://DOMAIN/mqtt, badges use
# DOMAIN:8883. A single host, not a wildcard.
DOMAIN=badge.example.com

# Contact address for the ACME account. Let's Encrypt sends expiry warnings
# here if renewal ever stops working.
ACME_EMAIL=you@example.com

# === Credentials (generated by scripts/setup-production.sh) ===
#
# These must match the hashes in config/passwd.production. Do not hand-edit
# them; run scripts/setup-production.sh --rotate to change them.
#
# WEB_PASSWORD=
# OPERATOR_PASSWORD=
# HEALTH_PASSWORD=

# === Optional ===

# ACME directory. Point at the Let's Encrypt staging CA while rehearsing a
# deployment so failed attempts do not burn the production rate limit (5
# duplicate certificates per week). Staging certificates are NOT trusted by
# browsers - switch back and re-deploy once the flow works end to end.
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# TLS override for the Caddy site block. Leave unset in production so Caddy
# manages certificates automatically over ACME. Set to "tls internal" to
# rehearse the stack locally with Caddy's own CA, or to
# "tls /path/cert.pem /path/key.pem" to supply certificates yourself.
# Quote it - the value contains a space.
# TLS_DIRECTIVE="tls internal"

# How often certsync checks Caddy's certificate store, in seconds. The default
# of 6h is far more frequent than the ~30 day renewal cadence.
# SYNC_INTERVAL=21600

# How often mosquitto re-hashes its certificate to detect a renewal, in
# seconds. On change the broker process is restarted in place to bind the new
# certificate - a sub-second blip roughly once a month.
# CERT_WATCH_INTERVAL=300
